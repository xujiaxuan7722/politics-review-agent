# 复制为 .env 并填入自己的密钥。切勿把 .env 提交到 git 或打进压缩包。
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_CHAT_MODEL=Qwen/Qwen3-8B
SILICONFLOW_EMBED_MODEL=BAAI/bge-m3

# ---- 可选：把模型调用拆成三组，每组可指向不同平台（留空 = 用上面的 SILICONFLOW_*）----
# 向量组（RAG 建索引/检索）。换模型必须重跑 scripts/build_rag_index.py
# EMBED_BASE_URL=
# EMBED_API_KEY=
# EMBED_MODEL=
# 通用对话组（讲解/出题/判卷/错题分析/问答）。CHAT_PROVIDER 决定思考开关的字段名：siliconflow | sensenova
# CHAT_PROVIDER=siliconflow
# CHAT_BASE_URL=
# CHAT_API_KEY=
# CHAT_MODEL=
# CHAT_THINKING=true   # false = 判卷/错题分析也一律关思考（更快更省）
# 判卷专用组（裁决型任务；只填 GRADER_MODEL 则沿用通用对话组的平台/地址/密钥）
# GRADER_MODEL=deepseek-v4-pro
# GRADER_THINKING=        # 留空跟随 CHAT_THINKING
# 学习管家专用组（多步工具调用，建议用 function calling 更稳的大模型；失败自动降级到通用对话组）
# MANAGER_PROVIDER=sensenova
# MANAGER_BASE_URL=https://token.sensenova.cn/v1
# MANAGER_API_KEY=
# MANAGER_MODEL=deepseek-v4-pro

BAIDU_OCR_API_KEY=xxxxxxxxxxxx
BAIDU_OCR_SECRET_KEY=xxxxxxxxxxxx

# PostgreSQL（推荐）：docker run -d --name politics-postgres -e POSTGRES_USER=politics -e POSTGRES_PASSWORD=politics_dev -e POSTGRES_DB=politics -p 127.0.0.1:15434:5432 postgres:17
DATABASE_URL=postgresql+psycopg://politics:politics_dev@127.0.0.1:15434/politics
# 本地快速试用也可用 SQLite：
# DATABASE_URL=sqlite:///./politics.db
